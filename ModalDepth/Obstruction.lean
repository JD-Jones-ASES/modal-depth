import ModalDepth.Basic

namespace ModalDepth

namespace Obstruction

open Formula

/-- Composition in the presented Hilbert system. -/
theorem imp_trans {A B D : Formula α}
    (hAB : Provable n (.imp A B)) (hBD : Provable n (.imp B D)) :
    Provable n (.imp A D) := by
  have ht := Provable.taut (n := n)
    (PropForm.imp (.imp (.atom A) (.atom B))
      (.imp (.imp (.atom B) (.atom D)) (.imp (.atom A) (.atom D))))
    (by intro v; simp only [PropForm.eval]; tauto)
  exact .mp (.mp ht hAB) hBD

/-- Normal modal monotonicity, using necessitation and K. -/
theorem box_mono {A B : Formula α} (h : Provable n (.imp A B)) :
    Provable n (.imp (.box A) (.box B)) :=
  .mp (.k A B) (.nec h)

theorem boxes_mono (r : ℕ) {A B : Formula α} (h : Provable n (.imp A B)) :
    Provable n (.imp (boxes r A) (boxes r B)) := by
  induction r with
  | zero => exact h
  | succ r ih => exact box_mono ih

theorem conj_left (A B : Formula α) : Provable n (.imp (conj A B) A) := by
  exact Provable.taut
    (.imp (.imp (.imp (.atom A) (.imp (.atom B) .bot)) .bot) (.atom A))
    (by intro v; simp only [PropForm.eval]; tauto)

theorem conj_right (A B : Formula α) : Provable n (.imp (conj A B) B) := by
  exact Provable.taut
    (.imp (.imp (.imp (.atom A) (.imp (.atom B) .bot)) .bot) (.atom B))
    (by intro v; simp only [PropForm.eval]; tauto)

/-- The n-transitivity implication is derived, rather than added as an axiom. -/
theorem n_transitivity (A : Formula α) :
    Provable n (.imp (.box A) (boxes (n + 1) A)) := by
  let Q := conj A (boxes n A)
  have hUV : Provable n (.imp (boxes n Q) (boxes n A)) :=
    boxes_mono n (conj_left A (boxes n A))
  have ht := Provable.taut (n := n)
    (PropForm.imp (.imp (.atom (boxes n Q)) (.atom (boxes n A)))
      (.imp (.atom A) (.imp (.atom (boxes n Q))
        (.imp (.imp (.atom A) (.imp (.atom (boxes n A)) .bot)) .bot))))
    (by intro v; simp only [PropForm.eval]; tauto)
  have hp : Provable n (.imp A (.imp (boxes n Q) Q)) := .mp ht hUV
  have hq : Provable n (.imp (.box A) (.box Q)) :=
    imp_trans (box_mono hp) (.loeb Q)
  exact imp_trans hq (box_mono (conj_right A (boxes n A)))

theorem boxes_add (a b : ℕ) (A : Formula α) :
    boxes (a + b) A = boxes a (boxes b A) := by
  induction a with
  | zero => simp only [Nat.zero_add, boxes]
  | succ a ih => simpa only [Nat.succ_add, boxes] using congrArg Formula.box ih

/-- Every positive depth is identified with its translate by n by theoremhood. -/
theorem positive_n_transitivity (A : Formula α) (hk : 0 < k) :
    Provable n (.imp (boxes k A) (boxes (k + n) A)) := by
  obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hk)
  have h := boxes_mono j (n_transitivity (n := n) A)
  change Provable n (.imp (boxes j (boxes 1 A)) (boxes j (boxes (n + 1) A))) at h
  simpa only [← boxes_add, Nat.succ_eq_add_one, Nat.add_assoc, Nat.add_comm 1 n]
    using h

/-- At world x, accessible worlds are precisely the strictly smaller naturals.
The subframe generated by any world is a finite strict transitive chain. -/
def eval (v : ℕ → α → Prop) : ℕ → Formula α → Prop
  | x, .atom p => v x p
  | _, .bot => False
  | x, .imp A B => eval v x A → eval v x B
  | x, .box A => ∀ y, y < x → eval v y A

theorem eval_prop_subst (t : PropForm (Formula α)) (v : ℕ → α → Prop) (x : ℕ) :
    eval v x (t.subst id) ↔ t.eval (eval v x) := by
  induction t with
  | atom p => rfl
  | bot => rfl
  | imp A B ihA ihB => simp only [PropForm.subst, eval, PropForm.eval, ihA, ihB]

theorem eval_boxes_of_below (A : Formula α) (v : ℕ → α → Prop)
    (r : ℕ) (hr : 0 < r) {x : ℕ}
    (h : ∀ y, y < x → eval v y A) : eval v x (boxes r A) := by
  induction r generalizing x with
  | zero => omega
  | succ r ih =>
    intro y hy
    cases r with
    | zero => exact h y hy
    | succ r =>
      apply ih (by omega)
      intro z hz
      exact h z (lt_trans hz hy)

/-- Soundness of the displayed weak Löb schema on finite descending chains. -/
theorem eval_loeb (hn : 0 < n) (A : Formula α) (v : ℕ → α → Prop) (x : ℕ) :
    eval v x (.imp (.box (.imp (boxes n A) A)) (.box A)) := by
  intro h y hy
  induction y using Nat.strong_induction_on with
  | h y ih =>
    apply h y hy
    apply eval_boxes_of_below A v n hn
    intro z hz
    exact ih z hz (lt_trans hz hy)

/-- Soundness uses the actual Hilbert derivation, including its necessitation rule. -/
theorem sound (hn : 0 < n) {A : Formula α} (h : Provable n A)
    (v : ℕ → α → Prop) (x : ℕ) : eval v x A := by
  induction h generalizing x with
  | taut t ht => exact (eval_prop_subst t v x).mpr (ht (eval v x))
  | k A B => intro hAB hA y hy; exact hAB y hy (hA y hy)
  | loeb A => exact eval_loeb hn A v x
  | mp hAB hA ihAB ihA => exact ihAB x (ihA x)
  | nec h ih => intro y hy; exact ih y

/-- A formula with no signed occurrences is invariant under all valuations. -/
theorem eval_atom_free (A : Formula α)
    (h : ∀ s d p, ¬ A.Occurs s d p)
    (v w : ℕ → α → Prop) (x : ℕ) : eval v x A ↔ eval w x A := by
  induction A generalizing x with
  | atom p => exact (h true 0 p ⟨rfl, rfl, rfl⟩).elim
  | bot => rfl
  | imp A B ihA ihB =>
    have hA : ∀ s d p, ¬ A.Occurs s d p := by
      intro s d p hp
      apply h (!s) d p
      exact Or.inl (by simpa using hp)
    have hB : ∀ s d p, ¬ B.Occurs s d p := by
      intro s d p hp
      exact h s d p (Or.inr hp)
    exact imp_congr (ihA hA x) (ihB hB x)
  | box A ih =>
    have hA : ∀ s d p, ¬ A.Occurs s d p := by
      intro s d p hp
      exact h s (d + 1) p ⟨d, rfl, hp⟩
    exact forall_congr' (fun y => imp_congr_right (fun _ => ih hA y))

theorem occurs_boxes_atom (r : ℕ) (p q : α) (s : Bool) (d : ℕ) :
    (boxes r (.atom p)).Occurs s d q ↔ s = true ∧ d = r ∧ q = p := by
  induction r generalizing d with
  | zero => rfl
  | succ r ih =>
    simp only [boxes, Occurs, ih]
    constructor
    · rintro ⟨e, rfl, hs, rfl, hq⟩
      exact ⟨hs, rfl, hq⟩
    · rintro ⟨hs, rfl, hq⟩
      exact ⟨r, rfl, hs, rfl, hq⟩

theorem unsigned_boxes_atom (c : ℕ → C) (r : ℕ) (p q : α) (z : C) :
    (boxes r (.atom p)).unsigned c q z ↔ q = p ∧ c r = z := by
  simp only [unsigned, support, occurs_boxes_atom]
  constructor
  · rintro ⟨s, d, ⟨hs, rfl, hq⟩, hz⟩
    exact ⟨hq, hz⟩
  · rintro ⟨hq, hz⟩
    exact ⟨true, r, ⟨rfl, rfl, hq⟩, hz⟩

theorem eval_boxes_true (r : ℕ) (p : α) (x : ℕ) :
    eval (fun _ _ => True) x (boxes r (.atom p)) := by
  induction r generalizing x with
  | zero => trivial
  | succ r ih => intro y hy; exact ih y

theorem not_eval_boxes_endpoint (r : ℕ) (p : α) :
    ¬ eval (fun x _ => x ≠ 0) r (boxes r (.atom p)) := by
  induction r with
  | zero => exact fun h => h rfl
  | succ r ih => exact fun h => ih (h r (Nat.lt_succ_self r))

end Obstruction

/-- Unsigned depth-label Craig interpolation forces positive n-periodicity.
This direction has no ordinary interpolation assumption. -/
theorem unsignedCraig_periodic (hn : 0 < n) [Nonempty α]
    (h : UnsignedCraig n c α) : PositivePeriodic n c := by
  classical
  intro k hk
  by_contra hc
  let p : α := Classical.choice ‹Nonempty α›
  obtain ⟨I, hAI, hIB, hsupport⟩ := h
    (Formula.boxes k (.atom p)) (Formula.boxes (k + n) (.atom p))
    (Obstruction.positive_n_transitivity (.atom p) hk)
  have hfree : ∀ s d q, ¬ I.Occurs s d q := by
    intro s d q ho
    have hi : I.unsigned c q (c d) := ⟨s, d, ho, rfl⟩
    obtain ⟨ha, hb⟩ := hsupport q (c d) hi
    have ha' := (Obstruction.unsigned_boxes_atom c k p q (c d)).mp ha
    have hb' := (Obstruction.unsigned_boxes_atom c (k + n) p q (c d)).mp hb
    exact hc (hb'.2.trans ha'.2.symm)
  have hIt : Obstruction.eval (fun _ _ => True) (k + n) I :=
    Obstruction.sound hn hAI _ _ (Obstruction.eval_boxes_true k p (k + n))
  have hIf : Obstruction.eval (fun x _ => x ≠ 0) (k + n) I :=
    (Obstruction.eval_atom_free I hfree _ _ (k + n)).mp hIt
  exact Obstruction.not_eval_boxes_endpoint (k + n) p
    (Obstruction.sound hn hIB _ _ hIf)

end ModalDepth
